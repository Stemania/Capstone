FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

DATABASE_URL=postgresql+psycopg://bmsc:bmsc_dev@localhost:5432/bmsc

# Optional. Leave unset for local/dev — rate limiting uses memory:// by default.
# Only set when you have a real Redis and want shared limits across workers.
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173

# Notifications (default: console — no paid account required)
NOTIFICATION_EMAIL_PROVIDER=console
NOTIFICATION_SMS_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
