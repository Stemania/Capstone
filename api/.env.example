FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

DATABASE_URL=postgresql+psycopg://bmsc:bmsc_dev@localhost:5432/bmsc

# Optional. Leave unset for local/dev — rate limiting uses memory:// by default.
# Only set when you have a real Redis and want shared limits across workers.
# REDIS_URL=redis://localhost:6379/0
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173

# Notifications. Nothing is sent unless NOTIFICATIONS_ENABLED=true.
# NOTIFY_ALLOWLIST: comma-separated emails/phones; when set, only these receive.
NOTIFICATIONS_ENABLED=
NOTIFY_ALLOWLIST=
# Links in invitation and password-reset emails, e.g. https://your-app.vercel.app
FRONTEND_URL=
# EMAIL_BACKEND: gmail_api | smtp | console (empty = console)
EMAIL_BACKEND=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
# SMS_BACKEND: console only for now
SMS_BACKEND=
# smtp backend, local development only:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Log API method/path/duration (off by default)
# REQUEST_TIMING=1
